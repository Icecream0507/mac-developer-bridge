diff --git a/lib/chrome-csv-file.mjs b/lib/chrome-csv-file.mjs
new file mode 100644
--- /dev/null
+++ b/lib/chrome-csv-file.mjs
@@ -0,0 +1,127 @@
+import crypto from "node:crypto";
+import fs from "node:fs";
+import fsp from "node:fs/promises";
+import path from "node:path";
+
+export const MAX_CHROME_CSV_FILE_BYTES = 1024 * 1024;
+function csvError(code, message) {
+  const error = new Error(message);
+  error.code = code;
+  return error;
+}
+
+function csvStructureIsValid(bytes) {
+  let value;
+  try { value = new TextDecoder("utf-8", { fatal: true }).decode(bytes); }
+  catch { return false; }
+  if (!value.length || /[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/.test(value)) return false;
+  let quoted = false, afterQuote = false, fieldStart = true, recordStarted = false;
+  let columns = 1, width = null, records = 0;
+  const finishRecord = () => {
+    if (!recordStarted && columns === 1) return true;
+    if (width === null) width = columns;
+    if (columns !== width) return false;
+    records++;
+    return true;
+  };
+  for (let index = 0; index < value.length; index++) {
+    const char = value[index];
+    if (quoted) {
+      if (char === '"') {
+        if (value[index + 1] === '"') index++;
+        else { quoted = false; afterQuote = true; }
+      }
+      continue;
+    }
+    if (afterQuote && char !== "," && char !== "\r" && char !== "\n") return false;
+    if (char === '"') {
+      if (!fieldStart) return false;
+      quoted = true;
+      recordStarted = true;
+      fieldStart = false;
+    } else if (char === ",") {
+      columns++;
+      recordStarted = true;
+      fieldStart = true;
+      afterQuote = false;
+    } else if (char === "\r" || char === "\n") {
+      if (char === "\r" && value[index + 1] === "\n") index++;
+      if (!finishRecord()) return false;
+      columns = 1;
+      fieldStart = true;
+      afterQuote = false;
+      recordStarted = false;
+    } else {
+      recordStarted = true;
+      fieldStart = false;
+    }
+  }
+  return !quoted && finishRecord() && records > 0;
+}
+
+// Only an explicit file supplied by the caller is read. This helper never
+// discovers paths, follows symlinks, fetches URLs, or returns a private path.
+export async function prepareChromeCsvFile({ localPath, expectedSha256, mimeType } = {}) {
+  if (typeof localPath !== "string" || !path.isAbsolute(localPath) || localPath.includes("\0")
+      || localPath.length > 4096 || path.resolve(localPath) !== localPath) {
+    throw csvError("CHROME_CSV_PATH_INVALID", "An absolute normalized CSV path is required.");
+  }
+  if (mimeType !== "text/csv") throw csvError("CHROME_CSV_MIME_INVALID", "Only text/csv files are supported.");
+  if (typeof expectedSha256 !== "string" || !/^[a-f0-9]{64}$/.test(expectedSha256)) {
+    throw csvError("CHROME_CSV_HASH_MISMATCH", "The expected SHA-256 CSV digest is required.");
+  }
+  let handle;
+  try {
+    const initial = await fsp.lstat(localPath);
+    if (initial.isSymbolicLink() || await fsp.realpath(localPath) !== localPath) {
+      throw csvError("CHROME_CSV_SYMLINK", "The explicit CSV path must not contain a symlink.");
+    }
+    if (!initial.isFile()) throw csvError("CHROME_CSV_NOT_REGULAR", "The explicit CSV must be a regular file.");
+    if (initial.size < 1 || initial.size > MAX_CHROME_CSV_FILE_BYTES) {
+      throw csvError("CHROME_CSV_TOO_LARGE", "The CSV must be between 1 byte and 1 MiB.");
+    }
+    handle = await fsp.open(localPath, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
+    const before = await handle.stat();
+    if (!before.isFile()) throw csvError("CHROME_CSV_NOT_REGULAR", "The explicit CSV must be a regular file.");
+    if (before.dev !== initial.dev || before.ino !== initial.ino || before.size !== initial.size
+        || before.mtimeMs !== initial.mtimeMs || before.ctimeMs !== initial.ctimeMs) {
+      throw csvError("CHROME_CSV_CHANGED", "The CSV changed before it could be read.");
+    }
+    const buffer = Buffer.alloc(before.size + 1);
+    let length = 0;
+    while (length < buffer.length) {
+      const { bytesRead } = await handle.read(buffer, length, buffer.length - length, length);
+      if (!bytesRead) break;
+      length += bytesRead;
+    }
+    const after = await handle.stat();
+    const current = await fsp.lstat(localPath);
+    if (length !== before.size || after.size !== before.size || after.mtimeMs !== before.mtimeMs
+        || after.ctimeMs !== before.ctimeMs || current.isSymbolicLink()
+        || current.dev !== before.dev || current.ino !== before.ino
+        || await fsp.realpath(localPath) !== localPath) {
+      throw csvError("CHROME_CSV_CHANGED", "The CSV changed while it was being read.");
+    }
+    const bytes = buffer.subarray(0, length);
+    if (!csvStructureIsValid(bytes)) {
+      throw csvError("CHROME_CSV_SIGNATURE_MISMATCH", "The CSV must be valid UTF-8 comma-separated records with consistent columns, valid quoting, and no binary control bytes.");
+    }
+    const sha256 = crypto.createHash("sha256").update(bytes).digest("hex");
+    if (sha256 !== expectedSha256) throw csvError("CHROME_CSV_HASH_MISMATCH", "The CSV no longer matches the reviewed SHA-256 digest.");
+    const name = path.basename(localPath);
+    if (!/^[A-Za-z0-9][A-Za-z0-9._ -]{0,199}$/.test(name)) {
+      throw csvError("CHROME_CSV_PATH_INVALID", "Use an CSV filename containing ordinary letters, digits, spaces, dots, underscores or hyphens.");
+    }
+    const permittedExtensions = { "text/csv": [".csv"] };
+    if (!permittedExtensions[mimeType].includes(path.extname(name).toLowerCase())) {
+      throw csvError("CHROME_CSV_SIGNATURE_MISMATCH", "The CSV filename extension does not match its MIME type.");
+    }
+    return { name, mimeType, size: bytes.length, sha256, base64: bytes.toString("base64"), lastModified: Math.floor(before.mtimeMs) };
+  } catch (error) {
+    if (typeof error?.code === "string" && error.code.startsWith("CHROME_CSV_")) throw error;
+    // Filesystem error strings contain local paths. Never forward or audit them.
+    throw csvError(error?.code === "ELOOP" ? "CHROME_CSV_SYMLINK" : "CHROME_CSV_READ_FAILED", "The explicit CSV could not be read safely.");
+  } finally {
+    if (handle) await handle.close().catch(() => {});
+  }
+}
